{
  "name": "poker-banker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm icons && vite --host 127.0.0.1",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/db-local.ts",
    "start:local": "tsx src/server/local.ts",
    "icons": "tsx scripts/icons.ts",
    "e2e": "playwright test",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "bench": "tsx scripts/bench.ts",
    "bench:live": "tsx scripts/bench-live.ts",
    "bench:live:compare": "tsx scripts/bench-live-compare.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@node-rs/argon2": "^2.0.2",
    "hono": "^4.10.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "embedded-postgres": "^18.1.0-beta.15",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  }
}
